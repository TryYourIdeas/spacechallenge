# Copy this file to backend/docker/.env before changing local defaults.
API_PORT=8080
API_CONTAINER_PORT=8080
# Comma-separated browser origins allowed to call the API (add the Pages URL in production).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Host directory whose *.csv files can be imported (mounted read-only). Relative paths
# resolve from backend/docker; on the VM set an absolute path in shared/backend.env.
DATA_DIR=../../data
POSTGRES_IMAGE=jlabrada/postgis-pgvector:0.1.0
POSTGRES_DB=app
POSTGRES_USER=app
# Local-only default. Replace before using this stack beyond local development.
POSTGRES_PASSWORD=app
QUEUE_IMAGE=redis:7-alpine

# Optional: use an external database instead of the bundled postgres service.
# DATABASE_URL=postgres://user:password@host:5432/dbname
